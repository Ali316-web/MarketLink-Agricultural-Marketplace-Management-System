@using MarketLink.Admin.Models.Entities
@using MarketLink.Admin.Models.Enums
@model List<Customer>
@{
    ViewData["Title"] = "Customers";
    var status = (CustomerStatus?)ViewBag.Status;
}
<div class="page-head"><div><h1>Customers</h1><p>Deactivate accounts that violate platform policy.</p></div></div>

<form class="toolbar" method="get" asp-action="Index">
    <input type="search" name="search" value="@ViewBag.Search" placeholder="Search name or email" aria-label="Search customers" />
    <select name="status" aria-label="Filter by status" onchange="this.form.submit()">
        <option value="">All</option>
        @foreach (var s in Enum.GetValues<CustomerStatus>())
        {
            <option value="@s" selected="@(status == s)">@s</option>
        }
    </select>
</form>

<div class="tablewrap">
    @if (Model.Count == 0)
    {
        <partial name="_Empty" model="@("No customers match your filters.")" />
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Contact</th><th>Address</th><th>Orders</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><b>@c.Name</b><div class="muted small">Joined @c.JoinedOn.ToString("yyyy-MM-dd")</div></td>
                        <td>@c.Email<div class="muted small">@c.Phone</div></td>
                        <td>@c.Address</td>
                        <td>@c.TotalOrders</td>
                        <td><partial name="_Badge" model="c.Status" /></td>
                        <td class="act">
                            <a class="btn sm" asp-action="Details" asp-route-id="@c.Id">View</a>
                            @if (c.Status == CustomerStatus.Active)
                            {
                                <form class="inline" asp-action="ToggleStatus" asp-route-id="@c.Id" method="post"
                                      data-confirm="@($"{c.Name} will lose access to their account.")" data-confirm-label="Deactivate">
                                    <button class="btn sm danger" type="submit">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form class="inline" asp-action="ToggleStatus" asp-route-id="@c.Id" method="post">
                                    <button class="btn sm primary" type="submit">Activate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
