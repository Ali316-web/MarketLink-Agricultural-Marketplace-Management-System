@using System.Globalization
@using MarketLink.Admin.Models.Entities
@using MarketLink.Admin.Models.Enums
@model List<Market>
@{
    ViewData["Title"] = "Markets";
}
<div class="page-head">
    <div><h1>Markets</h1><p>Name, address, operating days, timings and map location.</p></div>
    <a class="btn primary" asp-action="Create">Add market</a>
</div>

<div class="tablewrap">
    @if (Model.Count == 0)
    {
        <partial name="_Empty" model="@("No markets yet. Add the first one.")" />
    }
    else
    {
        <table>
            <thead><tr><th>Market</th><th>Days</th><th>Timings</th><th>Coordinates</th><th>Map</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var days = Enum.GetValues<MarketDays>()
                        .Where(d => d != MarketDays.None && m.OpenDays.HasFlag(d))
                        .Select(d => d.ToString()[..3]);
                    <tr>
                        <td><b>@m.Name</b><div class="muted small">@m.Address</div></td>
                        <td>@string.Join(", ", days)</td>
                        <td>@m.OpenTime.ToString("HH:mm")–@m.CloseTime.ToString("HH:mm")</td>
                        <td class="small">@m.Latitude.ToString(CultureInfo.InvariantCulture), @m.Longitude.ToString(CultureInfo.InvariantCulture)</td>
                        <td><a href="@m.MapLink" target="_blank" rel="noopener">@(m.Provider == MapProvider.GoogleMaps ? "Google Maps" : "OpenStreetMap")</a></td>
                        <td class="act">
                            <a class="btn sm" asp-action="Edit" asp-route-id="@m.Id">Edit</a>
                            <form class="inline" asp-action="Delete" asp-route-id="@m.Id" method="post"
                                  data-confirm="@($"{m.Name} will be removed from the platform.")" data-confirm-label="Remove">
                                <button class="btn sm danger" type="submit">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
