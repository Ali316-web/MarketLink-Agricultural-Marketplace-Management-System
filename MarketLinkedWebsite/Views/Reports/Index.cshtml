@using MarketLink.Admin.Models.Entities
@using MarketLink.Admin.Models.Enums
@model List<GeneratedReport>
@{
    ViewData["Title"] = "Reports";
    var totalOrders = (int)ViewBag.TotalOrders;
    var totalRevenue = (decimal)ViewBag.TotalRevenue;
    var average = (decimal)ViewBag.AverageOrderValue;
    var byMarket = (List<(string Market, decimal Revenue, int Orders)>)ViewBag.RevenueByMarket;
    var top = (List<Farmer>)ViewBag.MostActiveFarmers;
    var maxRev = Math.Max(1m, byMarket.DefaultIfEmpty((string.Empty, 0m, 0)).Max(x => x.Revenue));
}
<div class="page-head">
    <div><h1>Reports and analytics</h1><p>Platform-wide totals across all markets.</p></div>
    <form class="add-row" style="margin:0" asp-action="Generate" method="post">
        <select name="type" aria-label="Report type" asp-items="Html.GetEnumSelectList<ReportType>()"></select>
        <button class="btn primary" type="submit">Generate report</button>
    </form>
</div>

<div class="stats" style="grid-template-columns:repeat(3,1fr)">
    <div class="stat"><div class="n">@totalOrders.ToString("N0")</div><div class="l">Total orders</div></div>
    <div class="stat"><div class="n">$@totalRevenue.ToString("N0")</div><div class="l">Total revenue</div></div>
    <div class="stat"><div class="n">$@average.ToString("N2")</div><div class="l">Average order value</div></div>
</div>

<div class="grid2">
    <div class="panel">
        <h2>Revenue by market</h2>
        @foreach (var x in byMarket)
        {
            <div class="bar-row">
                <span>@x.Market</span>
                <div class="bar"><i style="width:@((int)Math.Round(x.Revenue / maxRev * 100))%"></i></div>
                <span style="text-align:right">$@x.Revenue.ToString("N0")</span>
            </div>
        }
    </div>
    <div class="panel">
        <h2>Most active farmers</h2>
        <ul class="list">
            @foreach (var f in top)
            {
                <li>
                    <div class="t"><b>@f.StallName</b><div class="muted small">@(f.Market?.Name ?? "Unassigned")</div></div>
                    <span>@f.TotalOrders orders</span>
                </li>
            }
        </ul>
    </div>
</div>

<div class="panel">
    <h2>Generated reports</h2>
    <div class="tablewrap">
        <table>
            <thead><tr><th>ID</th><th>Report type</th><th>Generated by</th><th>Generated at</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>#@r.Id</td>
                        <td>@Html.DisplayFor(_ => r.Type)</td>
                        <td>@(r.GeneratedBy?.FullName ?? "Admin")</td>
                        <td>@r.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
